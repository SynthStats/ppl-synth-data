from __future__ import annotations

from typing import Any

import numpy as np

from ppl_synth_data.envs.base import BaseEnv


class {{ class_name }}(BaseEnv):
    """Declared process: z_j = (x_j - lo_j) / (hi_j - lo_j).

    Predictor eta(x) = intercept + sum(coefficients[j] * z_j).
    On reset, category weights w_k are independent Normal(0, 1) draws.
    Conditional on these weights, each response is Categorical(softmax(w*eta(x)));
    E[Y | x,w] = sum(k * softmax(w*eta(x))[k]); softmax link.
    Coefficients are full-domain predictor effects, with intercept at z=0.
    """
    env_name: str = "{{ spec['env_name'] }}"

    def __init__(self, seed: int | None = None) -> None:
        self._seed = 0 if seed is None else seed
        self._rng = np.random.default_rng(self._seed)
        self.observed_data: list[tuple[Any, ...]] = []
        self.include_prior: bool = False

        {% set parameter_units = {"intercept":"dimensionless predictor at all lower bounds","n_categories":"number of categories","coefficients":"dimensionless predictor change per full domain span"} %}
        {% set gp = require_parameters(spec, parameter_units) %}
        {% set distribution = "Categorical" %}
        {% set link = "softmax" %}
        {% set standardization = "minmax" %}
        {% set standardization_application = "all predictors before the category-weighted logits" %}
        {% include "_response_law.j2" +%}
        self._n_categories = int(self.response_law["parameters"]["n_categories"]["value"])
        self._intercept = float(self.response_law["parameters"]["intercept"]["value"])

        {% set features = spec["io_schema"]["feature_names"] %}
        self._feature_names = [{{ features | map("tojson") | join(", ") }}]
        {% include "_feature_domains.j2" +%}
        self._multi_feature_input = (
            {{ "True" if spec["io_schema"]["input_type"] == "json" else "False" }}
            or len(self._feature_names) > 1
        )

        {% include "_coefficients.j2" +%}
        self._weights: np.ndarray | None = None
        self.reset(seed=seed)

    def reset(self, seed: int | None = None) -> None:
        if seed is not None:
            self._seed = seed
        self._rng = np.random.default_rng(self._seed)
        self.observed_data = []
        self._weights = self._rng.normal(0, 1, size=self._n_categories)
        self.response_law["latent_parameters"]["category_weights"] = self._weights.tolist()

    def step(self, x_values: tuple[float, ...]) -> int:
        z = self._standardize_features(x_values)
        predictor = self._intercept + float(np.dot(self._slopes, z))
        logits = self._weights * predictor
        logits = logits - np.max(logits)
        probs = np.exp(logits)
        probs = probs / probs.sum()
        return int(self._rng.choice(self._n_categories, p=probs))

    def get_ordered_column_names(self) -> list[str]:
        return [*self._feature_names, "{{ target_name }}"]

    def generate_system_message(self, include_prior: bool = False, goal: str | None = None) -> str:
        base = f"This environment returns a categorical outcome (0 to {self._n_categories - 1})."
        if self._multi_feature_input:
            features = ", ".join(self._feature_names)
            base += f" Input: JSON object with numeric values for {features}."
        else:
            base += " Input: a single float."
        if include_prior:
            base += " Category probabilities depend on the input nonlinearly."
        if goal:
            base += f" Goal: {goal}"
        return base + self._input_domain_message()
