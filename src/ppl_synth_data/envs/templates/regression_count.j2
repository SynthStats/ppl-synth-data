from __future__ import annotations

from typing import Any

import numpy as np

from ppl_synth_data.envs.base import BaseEnv


class {{ class_name }}(BaseEnv):
    """Declared process: z_j = (x_j - lo_j) / (hi_j - lo_j).

    Log mean eta(x) = intercept + sum(coefficients[j] * z_j).
    Response Y | x ~ Poisson(exp(eta(x))), independently per query; log link.
    Coefficients are full-domain log-rate effects; intercept is the log rate at z=0.
    The mean is not clipped; excessively large Poisson rates are rejected by the sampler.
    """
    env_name: str = "{{ spec['env_name'] }}"

    def __init__(self, seed: int | None = None) -> None:
        self._seed = 0 if seed is None else seed
        self._rng = np.random.default_rng(self._seed)
        self.observed_data: list[tuple[Any, ...]] = []
        self.include_prior: bool = False

        {% set parameter_units = {"intercept":"log expected count at all lower bounds","coefficients":"log-rate change per full domain span"} %}
        {% set gp = require_parameters(spec, parameter_units) %}
        {% set distribution = "Poisson" %}
        {% set link = "log" %}
        {% set standardization = "minmax" %}
        {% set standardization_application = "all predictors before the log rate" %}
        {% include "_response_law.j2" +%}
        self._intercept = float(self.response_law["parameters"]["intercept"]["value"])

        {% set features = spec["io_schema"]["feature_names"] %}
        self._feature_names = [{{ features | map("tojson") | join(", ") }}]
        {% include "_feature_domains.j2" +%}
        self._multi_feature_input = (
            {{ "True" if spec["io_schema"]["input_type"] == "json" else "False" }}
            or len(self._feature_names) > 1
        )

        {% include "_coefficients.j2" +%}
        self.reset(seed=seed)

    def reset(self, seed: int | None = None) -> None:
        if seed is not None:
            self._seed = seed
        self._rng = np.random.default_rng(self._seed)
        self.observed_data = []

    def step(self, x_values: tuple[float, ...]) -> int:
        z = self._standardize_features(x_values)
        linear = self._intercept + float(np.dot(self._slopes, z))
        rate = np.exp(linear)
        return int(self._rng.poisson(rate))

    def get_ordered_column_names(self) -> list[str]:
        return [*self._feature_names, "{{ target_name }}"]

    def generate_system_message(self, include_prior: bool = False, goal: str | None = None) -> str:
        base = "This environment returns non-negative integer counts."
        if self._multi_feature_input:
            features = ", ".join(self._feature_names)
            base += f" Input: JSON object with numeric values for {features}."
        else:
            base += " Input: a single float."
        if include_prior:
            base += " The log expected count is linear in the domain-standardized features."
        if goal:
            base += f" Goal: {goal}"
        return base + self._input_domain_message()
